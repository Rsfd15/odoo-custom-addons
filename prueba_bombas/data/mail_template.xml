<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_prueba_bomba" model="mail.template">
        <field name="name">Prueba de bomba: enviar reporte al cliente</field>
        <field name="model_id" ref="model_bomba_prueba"/>
        <field name="subject">Reporte de prueba de bomba contra incendios {{ object.name }}</field>
        <field name="email_from">{{ (object.technician_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.customer_id.id }}</field>
        <field name="report_template_ids" eval="[(4, ref('prueba_bombas.action_report_prueba_bomba'))]"/>
        <field name="lang">{{ object.customer_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Estimado(a) <t t-out="object.customer_representative or object.customer_id.name or ''"/>:
        <br/><br/>
        Le enviamos adjunto el reporte de la prueba de rendimiento de la bomba contra incendios
        <strong t-out="object.name or ''"/>
        realizada el <t t-out="object.test_date and object.test_date.strftime('%d/%m/%Y') or ''"/>
        en <t t-out="object.location or ''"/>.
        <br/><br/>
        Quedamos a sus órdenes para cualquier duda.
        <br/><br/>
        Atentamente,<br/>
        <t t-out="object.technician_id.name or ''"/>
    </p>
</div>
        </field>
    </record>
</odoo>
