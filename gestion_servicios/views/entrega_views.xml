<odoo>
    <record id="view_servicio_entrega_list" model="ir.ui.view">
        <field name="name">servicio.entrega.list</field>
        <field name="model">servicio.entrega</field>
        <field name="arch" type="xml">
            <list string="Entregas de equipo">
                <field name="name"/>
                <field name="delivery_date"/>
                <field name="order_number"/>
                <field name="customer_id"/>
                <field name="delivered_by_id"/>
                <field name="receiver_name"/>
            </list>
        </field>
    </record>

    <record id="view_servicio_entrega_form" model="ir.ui.view">
        <field name="name">servicio.entrega.form</field>
        <field name="model">servicio.entrega</field>
        <field name="arch" type="xml">
            <form string="Entrega de equipo">
                <header>
                    <button name="action_download_report" type="object"
                            string="Descargar PDF" icon="download" class="btn-primary"/>
                    <button name="action_send_email" type="object"
                            string="Enviar por correo" icon="mail" class="btn-primary"/>
                </header>
                <sheet>
                    <!-- 1. Datos de entrega -->
                    <details open="open" style="margin-bottom:8px;">
                        <summary style="background:#e36c0a;color:#fff;font-weight:600;padding:14px 18px;border-radius:8px;cursor:pointer;list-style:none;">
                            ❯&#160;&#160;1. Datos de entrega
                        </summary>
                        <group class="mt-2">
                            <field name="name" readonly="1"/>
                            <field name="order_number"/>
                            <field name="customer_id"/>
                            <field name="delivery_date"/>
                            <field name="delivered_by_id" readonly="1" force_save="1"/>
                        </group>
                    </details>

                    <!-- 2. Equipo a entregar -->
                    <details open="open" style="margin-bottom:8px;">
                        <summary style="background:#e36c0a;color:#fff;font-weight:600;padding:14px 18px;border-radius:8px;cursor:pointer;list-style:none;">
                            ❯&#160;&#160;2. Equipo a entregar
                        </summary>
                        <field name="line_ids" nolabel="1" class="mt-2">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="product_model"/>
                                <field name="description"/>
                                <field name="quantity"/>
                                <field name="attachment_ids" widget="many2many_binary" string="Fotos de evidencia"/>
                            </list>
                        </field>
                    </details>

                    <!-- 3. Datos de recepción -->
                    <details style="margin-bottom:8px;">
                        <summary style="background:#e36c0a;color:#fff;font-weight:600;padding:14px 18px;border-radius:8px;cursor:pointer;list-style:none;">
                            ❯&#160;&#160;3. Datos de recepción
                        </summary>
                        <group class="mt-2">
                            <field name="receiver_name"/>
                            <field name="receiver_position"/>
                            <field name="receiver_signature" widget="signature"
                                   options="{'full_name': 'receiver_name', 'size': [400, 150]}"/>
                        </group>
                    </details>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_servicio_entrega" model="ir.actions.act_window">
        <field name="name">Entregas de equipo</field>
        <field name="res_model">servicio.entrega</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_servicio_entrega" name="ENTREGA DE EQUIPO"
              parent="menu_gestion_servicios_root"
              action="action_servicio_entrega" sequence="40"/>
</odoo>
