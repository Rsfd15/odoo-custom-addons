<odoo>
    <record id="view_servicio_cotizacion_list" model="ir.ui.view">
        <field name="name">servicio.cotizacion.list</field>
        <field name="model">servicio.cotizacion</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de cotización">
                <field name="name"/>
                <field name="request_date"/>
                <field name="customer_id"/>
                <field name="zone"/>
                <field name="technician_id"/>
                <field name="supply_option"/>
            </list>
        </field>
    </record>

    <record id="view_servicio_cotizacion_form" model="ir.ui.view">
        <field name="name">servicio.cotizacion.form</field>
        <field name="model">servicio.cotizacion</field>
        <field name="arch" type="xml">
            <form string="Solicitud de cotización">
                <header>
                    <button name="action_download_report" type="object"
                            string="Descargar PDF" icon="download" class="btn-primary"/>
                    <button name="action_send_email" type="object"
                            string="Enviar por correo" icon="mail" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- 1. Datos de la solicitud -->
                    <details open="open" style="margin-bottom:8px;">
                        <summary style="background:#e36c0a;color:#fff;font-weight:600;padding:14px 18px;border-radius:8px;cursor:pointer;list-style:none;">
                            ❯&#160;&#160;1. Datos de la solicitud
                        </summary>
                        <group class="mt-2">
                            <field name="reference_type" widget="radio"/>
                            <field name="reference_note" string="Añadir nota"/>
                            <field name="reference_attachment_ids" widget="many2many_binary" string="Adjuntar archivos multimedia"/>
                            <field name="request_date"/>
                            <field name="customer_id"/>
                            <field name="customer_phone" widget="phone"/>
                            <field name="zone"/>
                            <field name="location" class="o_geo_location" placeholder="Toca aquí para detectar tu ubicación"/>
                            <field name="technician_id" readonly="1" force_save="1"/>
                            <field name="required_time" placeholder="Ej. 4 horas"/>
                            <field name="people_count"/>
                            <field name="customer_contact"/>
                        </group>
                    </details>

                    <!-- 2. Detalle de la cotización -->
                    <details style="margin-bottom:8px;">
                        <summary style="background:#e36c0a;color:#fff;font-weight:600;padding:14px 18px;border-radius:8px;cursor:pointer;list-style:none;">
                            ❯&#160;&#160;2. Detalle de la cotización
                        </summary>

                        <separator string="Selecciona la siguiente opción"/>
                        <field name="supply_option" widget="radio" nolabel="1"/>

                        <separator string="Diagnóstico (máximo 4: el principal y 3 adicionales)"/>
                        <field name="diagnostic_ids" nolabel="1">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="fault_description"/>
                                <field name="corrective_action"/>
                            </list>
                            <form string="Diagnóstico">
                                <group string="Descripción de la falla">
                                    <field name="fault_description" nolabel="1" colspan="2" placeholder="Describe la falla"/>
                                    <field name="fault_note" string="Añadir nota"/>
                                </group>
                                <group string="Acción correctiva">
                                    <field name="corrective_action" nolabel="1" colspan="2" placeholder="Describe la acción correctiva"/>
                                    <field name="corrective_note" string="Añadir nota"/>
                                    <field name="attachment_ids" widget="many2many_binary" string="Adjuntar archivos multimedia"/>
                                </group>
                            </form>
                        </field>

                        <separator string="Material a cotizar (máximo 3)"/>
                        <field name="material_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="description"/>
                                <field name="brand"/>
                                <field name="product_model"/>
                                <field name="serial_number"/>
                                <field name="quantity"/>
                            </list>
                        </field>
                        <group string="Notas del material">
                            <field name="material_description_note" string="Descripción: añadir nota"/>
                            <field name="material_brand_note" string="Marca: añadir nota"/>
                            <field name="material_model_note" string="Modelo: añadir nota"/>
                            <field name="material_serial_note" string="Número de serie: añadir nota"/>
                            <field name="material_quantity_note" string="Cantidad: añadir nota"/>
                        </group>
                        <group string="Anexar imágenes">
                            <field name="material_images_note" string="Añadir nota"/>
                            <field name="material_attachment_ids" widget="many2many_binary" string="Adjuntar archivos multimedia"/>
                        </group>
                    </details>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_servicio_cotizacion" model="ir.actions.act_window">
        <field name="name">Solicitudes de cotización</field>
        <field name="res_model">servicio.cotizacion</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_servicio_cotizacion" name="SOLICITUD DE COTIZACIÓN"
              parent="menu_gestion_servicios_root"
              action="action_servicio_cotizacion" sequence="30"/>
</odoo>
