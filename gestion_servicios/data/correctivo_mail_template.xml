<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_correctivo" model="mail.template">
        <field name="name">Reporte correctivo: enviar al cliente</field>
        <field name="model_id" ref="model_servicio_correctivo"/>
        <field name="subject">Reporte correctivo {{ object.name }} - {{ object.work_name }}</field>
        <field name="email_from">{{ (object.supervisor_id.email_formatted or user.email_formatted) }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="partner_to">{{ object.customer_id.id }}</field>
        <field name="report_template_ids" eval="[(4, ref('gestion_servicios.action_report_correctivo'))]"/>
        <field name="lang">{{ object.customer_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Estimado(a) <t t-out="object.requester or object.customer_id.name or ''"/>:
        <br/><br/>
        Le enviamos adjunto el reporte correctivo
        <strong t-out="object.name or ''"/>
        de la obra <strong t-out="object.work_name or ''"/>,
        realizado el <t t-out="object.report_date and object.report_date.strftime('%d/%m/%Y') or ''"/>.
        <br/><br/>
        Quedamos a sus órdenes para cualquier duda.
        <br/><br/>
        Atentamente,<br/>
        <t t-out="object.supervisor_id.name or ''"/>
    </p>
</div>
        </field>
    </record>
</odoo>
