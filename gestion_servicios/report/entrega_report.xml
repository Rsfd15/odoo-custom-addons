<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_entrega" model="ir.actions.report">
        <field name="name">Entrega de equipo</field>
        <field name="model">servicio.entrega</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gestion_servicios.report_entrega_document</field>
        <field name="print_report_name">'Entrega-Equipo-%s' % (object.name or 'entrega')</field>
        <field name="paperformat_id" ref="paperformat_correctivo"/>
    </record>

    <template id="report_entrega_document">
        <t t-call="web.html_container">
            <t t-call="gestion_servicios.report_company_header"/>

            <t t-foreach="docs" t-as="o">
                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
                <div class="page corr-report">
                    <style>
                        .corr-report { font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #000; }
                        .corr-title { font-size: 26px; font-weight: bold; text-align: center; margin: 0 0 4px 0; }
                        .corr-kv { width: 100%; border-collapse: collapse; table-layout: fixed; }
                        .corr-kv th, .corr-kv td { border: 1px solid #000; padding: 4px 6px; vertical-align: top; }
                        .corr-kv th { width: 35%; background: #fbe5d6; text-align: left; font-size: 13px; }
                        .corr-kv td { font-size: 15px; word-wrap: break-word; word-break: break-all; }
                        .corr-kv tr { page-break-inside: avoid; }
                        .corr-band { background: #e36c0a; height: 16px; border: 1px solid #000; border-top: none; }
                        .corr-sec { background: #e36c0a; color: #fff; font-weight: bold; font-size: 13px; padding: 4px 6px; margin-top: 12px; }
                        /* Tabla de equipo: el encabezado se repite si cambia de hoja y ningún renglón se parte */
                        .ent-eq { width: 100%; border-collapse: collapse; table-layout: fixed; }
                        .ent-eq thead { display: table-header-group !important; }
                        .ent-eq tr { page-break-inside: avoid; }
                        .ent-eq th, .ent-eq td { border: 1px solid #000; padding: 4px 6px; vertical-align: top; word-wrap: break-word; word-break: break-all; }
                        .ent-eq th { background: #fbe5d6; text-align: left; font-size: 12px; }
                        .ent-eq td { font-size: 12px; }
                        .ent-eq .ent-model { width: 25%; }
                        .ent-eq .ent-qty { width: 14%; text-align: right; }
                        .ent-eq td.ent-photos { text-align: center; border-top: none; }
                        .ent-sign { page-break-inside: avoid; margin-top: 12px; }
                        .att-box { display: inline-block; width: 15%; margin: 0.8%; vertical-align: top; text-align: center; }
                        .att-box a { text-decoration: none; }
                        .att-img { max-width: 100%; max-height: 28mm; height: auto; width: auto; }
                        .att-box img { display: inline-block; }
                        .att-file { font-size: 10px; color: #555; margin: 4px 0; }
                        .sig-box { text-align: center; }
                        .sig-img { max-width: 100%; max-height: 35mm; }
                    </style>

                    <div class="corr-title">ENTREGA DE EQUIPO</div>

                    <!-- 1. Datos de entrega -->
                    <table class="corr-kv">
                        <tr><th>No. DE REMISIÓN</th><td><span t-field="o.name"/></td></tr>
                        <tr><th>No. DE PEDIDO</th><td><span t-field="o.order_number"/></td></tr>
                        <tr><th>NOMBRE DE LA EMPRESA</th><td><span t-field="o.customer_id"/></td></tr>
                        <tr><th>FECHA</th><td><t t-out="o.delivery_date and o.delivery_date.strftime('%d/%m/%Y') or ''"/></td></tr>
                        <tr><th>ENTREGADO POR</th><td><span t-field="o.delivered_by_id"/></td></tr>
                    </table>
                    <div class="corr-band"/>

                    <!-- 2. Equipo a entregar -->
                    <div class="corr-sec">EQUIPO A ENTREGAR</div>
                    <table class="ent-eq">
                        <thead>
                            <tr>
                                <th class="ent-model">Modelo</th>
                                <th>Descripción</th>
                                <th class="ent-qty">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.line_ids" t-as="line">
                                <tr>
                                    <td class="ent-model"><t t-out="line.product_model or ''"/></td>
                                    <td><t t-out="line.description"/></td>
                                    <td class="ent-qty"><t t-out="'%g' % line.quantity"/></td>
                                </tr>
                                <!-- Fotos de evidencia del equipo, debajo de su renglón -->
                                <tr t-if="line.attachment_ids">
                                    <td colspan="3" class="ent-photos">
                                        <t t-call="gestion_servicios.report_inspeccion_attachments" attachments="line.attachment_ids"/>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="not o.line_ids"><td colspan="3">Sin equipo registrado.</td></tr>
                        </tbody>
                    </table>

                    <!-- 3. Datos de recepción -->
                    <div class="ent-sign">
                        <div class="corr-sec">DATOS DE RECEPCIÓN</div>
                        <table class="corr-kv">
                            <tr><th>NOMBRE DE QUIEN RECIBE</th><td><span t-field="o.receiver_name"/></td></tr>
                            <tr><th>CARGO</th><td><span t-field="o.receiver_position"/></td></tr>
                            <tr>
                                <th>FIRMA</th>
                                <td>
                                    <div class="sig-box" t-if="o.receiver_signature">
                                        <img class="sig-img" t-att-src="signature_uri(o.receiver_signature)"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                </div>
            </t>

            <t t-call="gestion_servicios.report_company_footer"/>
        </t>
    </template>
</odoo>
